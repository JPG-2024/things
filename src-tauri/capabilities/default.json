{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://www.youtube.com/*" }]
    }
  ]
}
